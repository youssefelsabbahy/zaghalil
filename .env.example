# Demo mode (default ON): forms, newsletter and checkout never contact the brand.
# Set to 0 only on a deployment approved and configured by the brand owner.
NEXT_PUBLIC_DEMO_MODE=1
# Contact + newsletter forms POST JSON here (Formspree, Getform, or your own API).
# When empty, the forms fall back to opening a pre-filled email to the address below.
NEXT_PUBLIC_CONTACT_ENDPOINT=
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
NEXT_PUBLIC_CONTACT_EMAIL=Hello@Zaghalil.Com
# Orders: Shopify checkout URL. When empty, checkout sends the cart to WhatsApp.
NEXT_PUBLIC_CHECKOUT_URL=
NEXT_PUBLIC_WHATSAPP=201023446788
